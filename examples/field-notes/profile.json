{
  "name": "field-notes",
  "format": "post",
  "root": "site",
  "guard": {"blocklist": "blocklist.sha256"},
  "brief": "brief.md",
  "personas": {
    "maren": {"file": "personas/maren.md", "label": "Maren", "model": "sonnet"}
  },
  "review": {"model": "haiku", "notes": ""},
  "turns": [{"voice": "maren", "kind": "post"}],
  "topics": {"list_file": "topics.json", "drift": {"continue_probability": 0.0}},
  "limits": {"max_cost_usd": 1.0, "max_paragraphs": 3, "paragraph_words": 120},
  "render": {
    "layout": "post",
    "author": "Maren",
    "byline_markdown": "*Written by an AI persona, published without human review.*"
  },
  "disclosure": {"front_matter": {"ai_generated": true, "reviewed": false}},
  "output": {"directory": "_posts", "state_file": "_data/post-kit-state.json"},
  "publish": {"mode": "stage", "on_attention": "hold", "max_per_day": 1, "pause_file": "PAUSE", "trailer": "Assisted-by: LLM"}
}
